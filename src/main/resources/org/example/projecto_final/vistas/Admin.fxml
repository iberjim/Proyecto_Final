<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="700.0" spacing="20.0" style="-fx-background-color: #2b2b2b;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.projecto_final.controlador.AdminController">
    <children>
        <Label text="PANEL DE ADMINISTRACIÓN " textFill="WHITE">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <TableView fx:id="tablaUsuarios" prefHeight="250.0" prefWidth="660.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="80.0" text="ID Usuario" />
                <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre" />
                <TableColumn fx:id="colEmail" prefWidth="220.0" text="Email" />
                <TableColumn fx:id="colPassword" prefWidth="170.0" text="Contraseña" />
            </columns>
        </TableView>

        <GridPane hgap="10.0" vgap="15.0">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="400.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="Nombre:" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <Label text="Email:" textFill="WHITE" GridPane.rowIndex="1">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <Label text="Contraseña:" textFill="WHITE" GridPane.rowIndex="2">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="txtNombre" promptText="Nombre del usuario seleccionado" style="-fx-background-color: #3b3b3b; -fx-text-fill: white;" GridPane.columnIndex="1" />
                <TextField fx:id="txtEmail" promptText="Email del usuario seleccionado" style="-fx-background-color: #3b3b3b; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <TextField fx:id="txtPassword" promptText="Contraseña del usuario seleccionado" style="-fx-background-color: #3b3b3b; -fx-text-fill: white;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </children>
            <VBox.margin>
                <Insets left="20.0" right="20.0" />
            </VBox.margin>
        </GridPane>

        <HBox alignment="CENTER" prefHeight="60.0" prefWidth="200.0" spacing="30.0">
            <children>
                <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#ActualizarClick" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="✏️ Actualizar">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                </Button>
                <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#EliminarClick" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="❌ Eliminar">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                </Button>
                <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#VolverClick" style="-fx-background-color: #757575; -fx-text-fill: white;" text="🔙 Volver al Menú">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                </Button>
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
