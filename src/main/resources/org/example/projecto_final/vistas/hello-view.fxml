<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="550.0" prefWidth="500.0" spacing="20.0" style="-fx-background-color: #2b2b2b;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://fxml.com/fxml/1" fx:controller="org.example.projecto_final.controlador.MenuController">
   <padding>
      <Insets bottom="30.0" left="50.0" right="50.0" top="30.0" />
   </padding>
   <children>

      <Label text="TRES EN RAYA" textFill="WHITE">
         <font>
            <Font name="System Bold" size="36.0" />
         </font>
         <VBox.margin>
            <Insets bottom="20.0" />
         </VBox.margin>
      </Label>

      <Button fx:id="btnDUO" mnemonicParsing="false" onAction="#ElegirModo" prefHeight="60.0" prefWidth="250.0" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand;" text="⚔️  1 VS 1">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Button>

      <Button fx:id="btnIA" mnemonicParsing="false" onAction="#ElegirModo" prefHeight="60.0" prefWidth="250.0" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand;" text="🤖  1 VS IA">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Button>

      <Button fx:id="btnRanking" mnemonicParsing="false" onAction="#ElegirModo" prefHeight="60.0" prefWidth="250.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand;" text="🏆  RANKING">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Button>

      <Button fx:id="btnAdmin" mnemonicParsing="false" onAction="#ElegirModo" prefHeight="45.0" prefWidth="250.0" style="-fx-background-color: #757575; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand;" text="⚙️  Modo Administrador">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
      </Button>

   </children>
</VBox>